# ═══════════════════════════════════════════════════════════════════
# VN Portfolio Optimizer - .gitignore
# Python + Jupyter + Streamlit project
# ═══════════════════════════════════════════════════════════════════

# ─── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Virtual environments ───────────────────────────────────────────
.env
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ─── Testing & Coverage ────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ─── Jupyter Notebook ──────────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Untitled notebooks - never commit these
Untitled*.ipynb
notebooks/Untitled*.ipynb

# ─── IDE & Editors ─────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
.spyderproject
.spyproject

# ─── OS ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Streamlit ─────────────────────────────────────────────────────
.streamlit/secrets.toml
.streamlit/*.log

# ─── Project-specific: Data ────────────────────────────────────────
# Keep raw data folder structure but ignore actual DB files
data/raw/*.db
data/raw/*.db-journal
!data/raw/.gitkeep

# Processed data can be regenerated from raw
data/processed/*
!data/processed/.gitkeep

# Downloaded data caches
data/cache/
data/tmp/

# ─── Project-specific: Logs & Outputs ──────────────────────────────
# Application runtime logs (not committed to repo)
logs/*.log
logs/*.txt

# Temporary/experimental notebooks
notebooks/tmp_*.ipynb
notebooks/scratch_*.ipynb
notebooks/experiments/

# ─── Personal dev artifacts ────────────────────────────────────────
# .claude/ folder is tracked but sensitive files excluded
.claude/settings.local.json
.claude/*.private.md

# ─── Documentation builds ──────────────────────────────────────────
docs/_build/
docs/.docusaurus/
site/

# ─── Node (if any tooling) ─────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Miscellaneous ─────────────────────────────────────────────────
*.tmp
*.bak
*.orig
.cache/